# Local Lead Finder - optional environment keys.
# Copy this file to `.env` and fill in only what you want. The default sources
# (DesignRush, YellowPages, OpenStreetMap) need NOTHING here - leave it empty and they work.
#
#   cp .env.example .env        (macOS / Linux)
#   copy .env.example .env      (Windows)

# --- Yelp (optional) ------------------------------------------------------------------
# Turns on the Yelp source. Yelp blocks page scraping, so this uses their official, free
# Fusion API. Get a free key at https://docs.developer.yelp.com/ (create an app), then paste
# it here. Without it, the Yelp source is simply skipped.
YELP_API_KEY=
