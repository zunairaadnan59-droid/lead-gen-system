    {
      "id": "a3",
      "name": "Plan today's emails",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "// Decides who gets an email today. Follow-ups first, then new Day 1 emails, max CAP per day.\n// Status column: blank = not started, active = in sequence, done = all 4 sent,\n// replied / bounced = stopped automatically, anything else (e.g. \"skip\") = never email.\nconst CAP = 20;\nconst OFFSETS = { 2: 3, 3: 7, 4: 14 };   // follow-up step -> days after Day 1\n// A filled-in follow-up column in the sheet wins over the built-in template, so sheet edits are what gets sent.\nconst COLUMNS = { 2: 'Email (Day 3)', 3: 'Email (Day 7)', 4: 'Email (Day 14)' };\nconst ZONE = 'America/New_York';\nconst PORTFOLIO = 'https://drive.google.com/file/d/1IGIYt1fk7qlcFYgHbWXH48fI3DDCGk9Y/view?usp=sharing';\nconst SIGN = 'Zunaira\\nQuixify Media | zunaira@quixifymedia.com';\nconst OPTOUT = \"\\n\\nP.S. Not relevant? Reply 'no' and I won't email again.\";\n\nconst today = DateTime.now().setZone(ZONE).startOf('day');\nconst todayStr = today.toISODate();\nconst rows = $input.all().map(i => i.json);\n\nconst firstName = body => { const m = /^Hi ([^,\\n]+),/.exec(String(body || '')); return m ? m[1].trim() : 'there'; };\nconst company = c => String(c || '').replace(/\\s*\\(.*?\\)/g, '').trim();\nconst followup = (step, fn, co) => {\n  if (step === 2) return `Hi ${fn},\\n\\nQuick follow-up on the free holiday video for ${co}.\\n\\nIf it helps to see how we work first, here's our paid social portfolio: ${PORTFOLIO}. It covers Meta campaigns we've run for online stores in the US, UK and Asia.\\n\\nStill happy to record your 5 minute teardown. Just reply 'yes'.\\n\\n${SIGN}${OPTOUT}`;\n  if (step === 3) return `Hi ${fn},\\n\\nOne thing worth knowing: Meta ads need about 2 weeks to learn before they perform well. To be ready for Black Friday on 27 Nov, setup has to start by 10 Nov.\\n\\nIf you want help this season, the risk is on us. If our Holiday Sales Sprint doesn't earn its fee back in sales within 2 months, January is on us.\\n\\nWant the free video first so you can judge for yourself?\\n\\n${SIGN}${OPTOUT}`;\n  return `Hi ${fn},\\n\\nI'll stop here so I'm not cluttering your inbox.\\n\\nIf holiday sales become a priority, reply 'video' any time and I'll send the free teardown for ${co}.\\n\\nWishing you a busy December.\\n\\n${SIGN}`;\n};\n\nlet budget = CAP - rows.filter(r => String(r['Last sent'] || '').trim() === todayStr).length;\nconst out = [];\n\nfor (const r of rows) {\n  if (budget <= 0) break;\n  if (String(r['Status'] || '').trim().toLowerCase() !== 'active') continue;\n  const next = Number(r['Step'] || 0) + 1;\n  if (!OFFSETS[next]) continue;\n  const d1 = DateTime.fromISO(String(r['Day 1 sent'] || '').trim(), { zone: ZONE });\n  if (!d1.isValid || today.diff(d1.startOf('day'), 'days').days < OFFSETS[next]) continue;\n  out.push({ json: {\n    email: String(r['Email']).trim(), subject: 'Re: ' + r['Subject'],\n    body: String(r[COLUMNS[next]] || '').trim() || followup(next, firstName(r['Email (Day 1)']), company(r['Company'])),\n    step: next, day1: String(r['Day 1 sent']).trim(), status: next === 4 ? 'done' : 'active', today: todayStr } });\n  budget--;\n}\nfor (const r of rows) {\n  if (budget <= 0) break;\n  if (String(r['Status'] || '').trim() !== '' || !r['Email']) continue;\n  out.push({ json: {\n    email: String(r['Email']).trim(), subject: r['Subject'], body: r['Email (Day 1)'],\n    step: 1, day1: todayStr, status: 'active', today: todayStr } });\n  budget--;\n}\nreturn out;\n"
      }
    },
