    {
      "id": "b2",
      "name": "Reply or bounce?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        400
      ],
      "parameters": {
        "jsCode": "// Turns new inbox messages into sheet updates: replies stop the sequence, bounces mark the address.\nconst EMAIL = /[a-z0-9._%+-]+@[a-z0-9.-]+\\.[a-z]{2,}/g;\nconst out = [];\nfor (const it of $input.all()) {\n  const j = it.json;\n  const from = (String(j.from || '').toLowerCase().match(EMAIL) || [])[0];\n  if (!from || from.endsWith('@quixifymedia.com')) continue;\n  const subject = String(j.subject || '');\n  const isBounce = /mailer-daemon|postmaster/.test(from) || /undeliver|delivery status|failure notice|returned mail/i.test(subject);\n  if (isBounce) {\n    const text = (String(j.textPlain || j.text || '') + ' ' + String(j.textHtml || '')).toLowerCase();\n    const addrs = [...new Set(text.match(EMAIL) || [])]\n      .filter(a => !a.endsWith('quixifymedia.com') && !/mailer-daemon|postmaster/.test(a));\n    for (const a of addrs) out.push({ json: { email: a, status: 'bounced', note: 'Bounced: ' + subject.slice(0, 80) } });\n    continue;\n  }\n  out.push({ json: { email: from, status: 'replied', note: 'Replied: ' + subject.slice(0, 80) } });\n}\nreturn out;\n"
      }
    },
